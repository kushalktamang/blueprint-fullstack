{
  "name": "@blueprint/openapi",
  "version": "1.0.0",
  "description": "Generates OpenAPI doc",
  "keywords": [],
  "license": "ISC",
  "author": "",
  "type": "module",
  "exports": {
    "./contracts": {
      "types": "./dist/contracts/index.d.ts",
      "default": "./dist/contract/index.js"
    }
  },
  "scripts": {
    "gen": "tsx src/gen.ts",
    "build": "tsc && tsc-alias",
    "dev": "wait-on ../zod/dist/index.js && tsc && (concurrently \"tsc -w\" \"tsc-alias -w\")",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "clean": "rimraf dist tsconfig.tsbuildinfo .turbo node_modules"
  },
  "dependencies": {
    "@anatine/zod-openapi": "^2.2.7",
    "@ts-rest/core": "^3.52.1",
    "@ts-rest/open-api": "^3.52.1",
    "ts-pattern": "^5.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@blueprint/oxlint-config": "workspace:*",
    "@blueprint/ts-config": "workspace:*",
    "@blueprint/zod": "workspace:*",
    "@types/node": "^22.13.14",
    "concurrently": "^9.1.2",
    "oxfmt": "^0.37.0",
    "oxlint": "^1.80.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tsc-alias": "^1.8.12",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "wait-on": "^8.0.3"
  }
}
