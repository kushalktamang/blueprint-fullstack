{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "extends": ["./node_modules/@blueprint/oxlint-config/.oxlintrc.json"],
  "plugins": ["typescript", "unicorn", "import", "react", "react-perf", "jsx-a11y", "oxc"],
  "env": {
    "browser": true
  },
  "settings": {
    "react": { "linkComponents": [] }
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    // Missing useEffect/useMemo/useCallback deps → stale closures, one of
    // the most common React bug classes.
    "react/exhaustive-deps": "error",

    // Index-as-key breaks list reconciliation when order/items change.
    "react/no-array-index-key": "warn",

    // Inline object/function props defeat memoization → unnecessary re-renders.
    "react-perf/jsx-no-new-object-as-prop": "warn",
    "react-perf/jsx-no-new-function-as-prop": "warn",

    // Missing alt text on images — accessibility + genuinely broken UX for
    // screen readers, worth blocking rather than warning.
    "jsx-a11y/alt-text": "error",
    "react/react-in-jsx-scope": "off",
    "react/jsx-max-depth": ["warn", { "max": 6 }],
    "func-style": ["warn", "declaration", { "allowArrowFunctions": true }]
  }
}
